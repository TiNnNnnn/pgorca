Proj*<a1 s1>(Proj*<a0 s0>(Input<t0>))|Proj*<a2 s2>(Input<t1>)|AttrsSub(a0,t0);AttrsSub(a1,s0);TableEq(t1,t0);AttrsEq(a2,a1);SchemaEq(s2,s1)

Union*<a0 s0>(Input<t0>,Input<t1>)|Proj*<a1 s1>(Union<a2 s2>(Input<t2>,Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a1,a0);SchemaEq(s1,s0);AttrsEq(a2,a0);SchemaEq(s2,s0)

InnerJoin<a0 a1 a2 s0>(Union(Input<t0>,Input<t1>),Input<t2>)|Union<a7 s1>(InnerJoin<a3 a4>(Input<t3>,Input<t4>),InnerJoin<a5 a6>(Input<t5>,Input<t6>))|AttrsSub(a0,t0);AttrsSub(a1,t2);TableEq(t3,t0);TableEq(t5,t1);TableEq(t4,t2);TableEq(t6,t2);AttrsEq(a3,a0);AttrsEq(a5,a0);AttrsEq(a4,a1);AttrsEq(a6,a1);AttrsEq(a7,a2);SchemaEq(s1,s0)

LeftJoin<a0 a1 a2 s0>(Union(Input<t0>,Input<t1>),Input<t2>)|Union<a7 s1>(LeftJoin<a3 a4>(Input<t3>,Input<t4>),LeftJoin<a5 a6>(Input<t5>,Input<t6>))|AttrsSub(a0,t0);AttrsSub(a1,t2);TableEq(t3,t0);TableEq(t5,t1);TableEq(t4,t2);TableEq(t6,t2);AttrsEq(a3,a0);AttrsEq(a5,a0);AttrsEq(a4,a1);AttrsEq(a6,a1);AttrsEq(a7,a2);SchemaEq(s1,s0)

Proj<a2 s1>(InSubFilter<a1>(Input<t0>,Proj<a0 s0>(Input<t1>)))|Proj<a6 s3>(InnerJoin<a3 a4>(Input<t2>,Proj*<a5 s2>(Input<t3>)))|AttrsSub(a0,t1);AttrsSub(a1,t0);AttrsSub(a2,t0);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a3,a1);AttrsEq(a4,a0);AttrsEq(a5,a0);SchemaEq(s2,s0);AttrsEq(a6,a2);SchemaEq(s3,s1)

Compute<e0 a0 s0>(Compute<e1 a1 s1>(Input<t0>))|Compute<e2 a2 s2>(Input<t1>)|TableEq(t1,t0);ExprDepsDisjoint(e0,s1);ExprConcat(e2,e0,e1)

# DIRECT(expression-rewrite): the operator skeleton stays unchanged, but
# ExprSplit moves the maximal safe expression subset into the lower Compute.
Compute<e0 a0 s0>(Compute<e1 a1 s1>(Input<t0>))|Compute<e3 a3 s3>(Compute<e2 a2 s2>(Input<t1>))|TableEq(t1,t0);ExprSplit(e2,e3,e0,e1)

InSubFilter<a0>(Input<t0>,Proj*<a1 s0>(Input<t1>))|InSubFilter<a2>(Input<t2>,Proj<a3 s1>(Input<t3>))|AttrsSub(a0,t0);AttrsSub(a1,t1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a2,a0);AttrsEq(a3,a1);SchemaEq(s1,s0)

Exists(Input<t0>,Proj*<a0 s0>(Input<t1>))|Exists(Input<t2>,Proj<a1 s1>(Input<t3>))|AttrsSub(a0,t1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a1,a0);SchemaEq(s1,s0)

NotExists(Input<t0>,Proj*<a0 s0>(Input<t1>))|NotExists(Input<t2>,Proj<a1 s1>(Input<t3>))|AttrsSub(a0,t1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a1,a0);SchemaEq(s1,s0)

Any<p0 a0>(Input<t0>,Proj*<a1 s0>(Input<t1>))|Any<p1 a2>(Input<t2>,Proj<a3 s1>(Input<t3>))|AttrsSub(a0,t0);AttrsSub(a1,t1);TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a2,a0);AttrsEq(a3,a1);SchemaEq(s1,s0)

All<p0 a0>(Input<t0>,Proj*<a1 s0>(Input<t1>))|All<p1 a2>(Input<t2>,Proj<a3 s1>(Input<t3>))|AttrsSub(a0,t0);AttrsSub(a1,t1);TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a2,a0);AttrsEq(a3,a1);SchemaEq(s1,s0)

# BRIDGE(view-materialization): source and target are logically identical.
# The C++ pre-unnest view performs the scalar-subquery lowering; these rules
# only materialize that virtual view and are not final independent replacements.
# Representation-lowering identities for the four relationally valued
# subquery predicates handled by CXformSelect2Apply. The DSL operators denote
# the same logic before and after unnesting; when the source is a scalar
# Select predicate, their existing target builders materialize the appropriate
# Apply and preserve every residual conjunct. These rules change no logical
# operator order and all four exact RuleIR strings returned EQ from SQLSolver
# on 2026-08-30. Scalar single-row subqueries remain a separate operator gap.
Exists(Input<t0>,Input<t1>)|Exists(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1)

# BRIDGE(view-materialization): same lowering boundary as the Exists sibling.
NotExists(Input<t0>,Input<t1>)|NotExists(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1)

# BRIDGE(view-materialization): same lowering boundary as the Exists sibling.
Any<p0 a0>(Input<t0>,Input<t1>)|Any<p1 a1>(Input<t2>,Input<t3>)|AttrsSub(a0,t0);TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a1,a0)

# BRIDGE(view-materialization): same lowering boundary as the Exists sibling.
All<p0 a0>(Input<t0>,Input<t1>)|All<p1 a1>(Input<t2>,Input<t3>)|AttrsSub(a0,t0);TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a1,a0)

# BRIDGE(view-materialization): the C++ Select view performs the lowering;
# FormalSQL proves only the visible InnerApply identity.
# Representation-lowering identity for a scalar single-row subquery in a
# filter expression. InnerApply names the post-unnest relational carrier while
# the matcher also exposes the pre-unnest Select as that same view. Predicate
# and dependency vectors are exact, including correlation attrs; required
# inner-column and origin-subquery metadata remain optimizer-owned. This exact
# RuleIR is accepted by the FormalSQL/Rocq structural proof kernel.
InnerApply<p0 a0 a1 a2>(Input<t0>,Input<t1>)|InnerApply<p1 a3 a4 a5>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsEq(a5,a2)

# BRIDGE(view-materialization): the C++ Project view performs the lowering;
# FormalSQL proves only the visible Project/Apply identity.
# Representation-lowering identity for a scalar single-row subquery in a
# projection value. The Project matcher exposes ORCA's normalized
# Proj(LeftApply) carrier and the target retains the exact residual project
# expressions plus Apply cardinality/correlation metadata. FormalSQL/Rocq
# proves the complete Proj/LeftApply structure, not an operator-local shortcut.
Proj<a0 s0>(LeftApply<p0 a1 a2 a3>(Input<t0>,Input<t1>))|Proj<a4 s1>(LeftApply<p1 a5 a6 a7>(Input<t2>,Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a5,a1);AttrsEq(a6,a2);AttrsEq(a7,a3);AttrsEq(a4,a0);SchemaEq(s1,s0)

# BRIDGE(view-materialization): the C++ Project view constructs this production
# alternative; the identity rule only materializes the complete visible tree.
# Preserve the second production Project2Apply alternative when scalar
# lowering introduces a compensation Project (for example count-zero
# semantics). This is a separate structural identity, so neither matcher nor
# instantiator needs to recognize the expression that caused the extra shell.
Proj<a0 s0>(Proj<a1 s1>(LeftApply<p0 a2 a3 a4>(Input<t0>,Input<t1>)))|Proj<a5 s2>(Proj<a6 s3>(LeftApply<p1 a7 a8 a9>(Input<t2>,Input<t3>)))|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a7,a2);AttrsEq(a8,a3);AttrsEq(a9,a4);AttrsEq(a6,a1);SchemaEq(s3,s1);AttrsEq(a5,a0);SchemaEq(s2,s0)

# BRIDGE(view-materialization): the C++ Project view constructs this decorrelated
# alternative; the identity rule preserves its grouping-only compensation.
# Preserve the decorrelated Project2Apply alternative whose value compensation
# deduplicates outer keys plus the generated marker above a regular LeftApply.
# Proj* is the exact abstraction of this grouping-only GbAgg; the identity does
# not inspect the scalar expression or subquery polarity.
Proj<a0 s0>(Proj*<a1 s1>(LeftApply<p0 a2 a3 a4>(Input<t0>,Input<t1>)))|Proj<a5 s2>(Proj*<a6 s3>(LeftApply<p1 a7 a8 a9>(Input<t2>,Input<t3>)))|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a7,a2);AttrsEq(a8,a3);AttrsEq(a9,a4);AttrsEq(a6,a1);SchemaEq(s3,s1);AttrsEq(a5,a0);SchemaEq(s2,s0)

# BRIDGE(view-materialization): the C++ Filter view performs subquery lowering;
# FormalSQL proves only the already-lowered Filter/Apply carrier identity.
# Preserve subqueries used in a general boolean Filter context.  Production
# lowering represents nullable scalar/existential/quantified values with
# LeftApply; the residual Filter contains the original three-valued expression
# over the generated value column.  This complete structural identity was
# accepted by the FormalSQL/Rocq kernel.
Filter<p0 a0 a1>(LeftApply<p1 a2 a3 a4>(Input<t0>,Input<t1>))|Filter<p2 a5 a6>(LeftApply<p3 a7 a8 a9>(Input<t2>,Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p2,p0);AttrsEq(a5,a0);AttrsEq(a6,a1);PredicateEq(p3,p1);AttrsEq(a7,a2);AttrsEq(a8,a3);AttrsEq(a9,a4)

# BRIDGE(view-materialization): the C++ aggregate view invokes production
# lowering; FormalSQL proves only the already-lowered Agg/Apply identity.
# Representation-lowering identity for a subquery used inside an aggregate
# argument.  The production handler introduces LeftApply below the aggregate;
# Agg symbols preserve grouping, aggregate inputs/functions, output schema and
# HAVING while Apply preserves its exact optimizer-owned carrier metadata.
# This complete RuleIR was accepted by the FormalSQL/Rocq kernel.
Agg<a0 a1 f0 s0 p0>(LeftApply<p1 a2 a3 a4>(Input<t0>,Input<t1>))|Agg<a5 a6 f1 s1 p2>(LeftApply<p3 a7 a8 a9>(Input<t2>,Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a5,a0);AttrsEq(a6,a1);FuncEq(f1,f0);SchemaEq(s1,s0);PredicateEq(p2,p0);PredicateEq(p3,p1);AttrsEq(a7,a2);AttrsEq(a8,a3);AttrsEq(a9,a4)

Proj*<a2 s0>(InnerJoin<a0 a1 p0 a3 a4>(Input<t0>,Input<t1>))|Proj<a7 s1>(InnerJoin<a5 a6 p1 a8 a9>(Input<t2>,Input<t3>))|AttrsSub(a0,t0);AttrsSub(a1,t1);AttrsSub(a2,t0);AttrsSub(a3,t0);AttrsSub(a4,t1);Unique(t0,a2);Unique(t1,a1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a5,a0);AttrsEq(a6,a1);PredicateEq(p1,p0);AttrsEq(a8,a3);AttrsEq(a9,a4);AttrsEq(a7,a2);SchemaEq(s1,s0)

Proj*<a2 s1>(InSubFilter<a1 a0 p0 a3 a4>(Input<t0>,Input<t1>))|Proj*<a7 s2>(InnerJoin<a5 a6 p1 a8 a9>(Input<t2>,Input<t3>))|AttrsSub(a0,t1);AttrsSub(a1,t0);AttrsSub(a2,t0);AttrsSub(a3,t0);AttrsSub(a4,t1);Unique(t0,a2);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a5,a1);AttrsEq(a6,a0);PredicateEq(p1,p0);AttrsEq(a8,a3);AttrsEq(a9,a4);AttrsEq(a7,a2);SchemaEq(s2,s1)

Proj*<a0 s0>(Exists<p0 a1 a2>(Input<t0>,Input<t1>))|Proj*<a3 s1>(InnerJoin<p1 a4 a5>(Input<t2>,Input<t3>))|AttrsSub(a0,t0);AttrsSub(a1,t0);AttrsSub(a2,t1);Unique(t0,a0);TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a4,a1);AttrsEq(a5,a2);AttrsEq(a3,a0);SchemaEq(s1,s0)

Proj*<a2 s0>(InnerJoin<a0 a1>(Input<t0>,Input<t1>))|Proj<a7 s2>(InnerJoin<a3 a4>(Proj*<a5 s1>(Input<t2>),Input<t3>))|AttrsSub(a0,t0);AttrsSub(a1,t1);AttrsSub(a2,t0);AttrsEq(a2,a0);Reference(t0,a0,t1,a1);Unique(t1,a1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsEq(a5,a2);SchemaEq(s1,s0);AttrsEq(a7,a2);SchemaEq(s2,s0)

Proj*<a2 s0>(InnerJoin<a0 a1>(Input<t0>,Input<t1>))|Proj<a7 s2>(InnerJoin<a3 a4>(Proj*<a5 s1>(Input<t2>),Input<t3>))|AttrsSub(a0,a2);AttrsSub(a2,t0);AttrsSub(a1,t1);Reference(t0,a0,t1,a1);Unique(t1,a1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsEq(a5,a2);SchemaEq(s1,s0);AttrsEq(a7,a2);SchemaEq(s2,s0)

Proj*<a2 s0>(InnerJoin<a0 a1 p0 a3 a4>(Input<t0>,Input<t1>))|Proj<a10 s2>(InnerJoin<a5 a6 p1 a7 a8>(Proj*<a9 s1>(Input<t2>),Input<t3>))|AttrsSub(a0,a2);AttrsSub(a2,t0);AttrsSub(a1,t1);AttrsSub(a3,a2);AttrsSub(a4,t1);Reference(t0,a0,t1,a1);Unique(t1,a1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a5,a0);AttrsEq(a6,a1);PredicateEq(p1,p0);AttrsEq(a7,a3);AttrsEq(a8,a4);AttrsEq(a9,a2);SchemaEq(s1,s0);AttrsEq(a10,a2);SchemaEq(s2,s0)

Proj*<a2 s0>(InnerJoin<a0 a1>(Input<t0>,Input<t1>))|Proj<a7 s2>(InnerJoin<a3 a4>(Proj*<a5 s1>(Input<t2>),Input<t3>))|AttrsSub(a0,t0);AttrsSub(a0,a2);AttrsSub(a1,t1);Reference(t0,a0,t1,a1);Unique(t1,a1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsIntersect(a5,a2,t0);AttrsIntersect(s1,s0,t0);AttrsEq(a7,a2);SchemaEq(s2,s0)

Proj*<a2 s0>(InnerJoin<a0 a1 p0 a3 a4>(Input<t0>,Input<t1>))|Proj<a10 s2>(InnerJoin<a5 a6 p1 a7 a8>(Proj*<a9 s1>(Input<t2>),Input<t3>))|AttrsSub(a0,t0);AttrsSub(a0,a2);AttrsSub(a1,t1);AttrsSub(a3,a2);AttrsSub(a3,t0);AttrsSub(a4,t1);Reference(t0,a0,t1,a1);Unique(t1,a1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a5,a0);AttrsEq(a6,a1);PredicateEq(p1,p0);AttrsEq(a7,a3);AttrsEq(a8,a4);AttrsIntersect(a9,a2,t0);AttrsIntersect(s1,s0,t0);AttrsEq(a10,a2);SchemaEq(s2,s0)

LeftJoin<p0 a0 a1>(Input<t0>,Input<t1>)|LeftJoin<p1 a2 a3>(Input<t2>,Empty<t3>)|AttrsSub(a0,t0);AttrsSub(a1,t1);PredicateFalse(p0);TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a2,a0);AttrsEq(a3,a1)

LeftJoin<p0 a0 a1>(Input<t0>,Filter<p1 a2>(Input<t1>))|LeftJoin<p2 a3 a4>(Input<t2>,Empty<t3>)|AttrsSub(a0,t0);AttrsSub(a1,t1);AttrsSub(a2,t1);PredicateFalse(p1);TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p2,p0);AttrsEq(a3,a0);AttrsEq(a4,a1)

# Replaces CXformLeftSemiJoin2CrossProduct when the semi predicate does not
# depend on the inner input. SemiJoin names the actual post-unnest relational
# operator rather than an Exists compatibility view. The inner LIMIT 1
# preserves existential bag multiplicity. This exact RuleIR is accepted by the
# generic FormalSQL/Rocq proof, verified 2026-08-29.
SemiJoin<p0 a0 a1>(Input<t0>,Input<t1>)|InnerJoin<p1 a2 a3>(Input<t2>,Limit<n0 n1>(Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a2,a0);AttrsEq(a3,a1);AttrsSub(a0,t0);AttrsEmpty(a1);Deterministic(p0);ScalarOne(n0);ScalarZero(n1);ErrorFree(p0);ErrorFree(p1)

# Replaces CXformLeftSemiApply2LeftSemiJoinNoCorrelations. SemiApply exposes
# immediate outer/inner correlation separately from the top predicate's local
# dependencies; AttrsEmpty therefore states the native xform's applicability
# domain directly. This exact RuleIR was proved by the FormalSQL/Rocq kernel on
# 2026-08-29.
SemiApply<p0 a0 a1 a2>(Input<t0>,Input<t1>)|SemiJoin<p1 a3 a4>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsEmpty(a2);ErrorFree(p0);ErrorFree(p1)

# Replaces the base-input domain of
# CXformLeftSemiApplyWithExternalCorrs2InnerJoin. PredicateDomainSplit
# partitions arbitrary safe top-level conjuncts into the current join domain
# and the enclosing query domain. KeyedOutput plus the equality-local columns
# form the exact witness grouping; the final Filter consumes those witness
# columns before projected observation returns the original outer row. The
# RuleIR is parametric in every predicate, attribute vector, and table and is
# accepted by the FormalSQL/Rocq external-semi-apply proof.
SemiApply<p0 a0 a1 a2>(Input<t0>,Filter<p1 a3 a4>(Input<t1>))|Filter<p3 a7 a8>(Proj*<a10 s0>(InnerJoin<p2 a5 a6>(Input<t2>,Input<t3>)))|TableEq(t2,t0);TableEq(t3,t1);PredicateDomainSplit(p0,p1,p2,p3,a5,a6,a7,a8,t0,t1);CorrelationEquality(p3,a7,a8);KeyedOutput(a9,t0);AttrsUnion(a10,a9,a7);SchemaFromAttrs(s0,a10);ErrorFree(p0);Deterministic(p0);ErrorFree(p1);Deterministic(p1);ErrorFree(p2);Deterministic(p2);ErrorFree(p3);Deterministic(p3);ErrorFree(a10)

# The grouped sibling is atomic only at the RuleIR/Cascades boundary: a parent
# Apply binding is not required to wait for a child Agg(Filter) alternative.
# Its proof composes the generic AggFilterCommute contract with the same
# arbitrary-right-tree CorrelationEquality law as the rule above.  Local filter
# dependencies must already be grouping keys, so this rule neither widens the
# aggregate schema nor depends on an xform-specific exception.
# WeTune ProveDslRule: PROJECTED_BAG_EQ, FORMALSQL/Rocq, verified 2026-09-01.
SemiApply<p0 a0 a1 a2>(Input<t0>,Agg<a3 a4 f0 s0 p1>(Filter<p2 a5 a6>(Input<t1>)))|Filter<p4 a11 a12>(Proj*<a14 s2>(InnerJoin<p3 a9 a10>(Input<t2>,Agg<a7 a8 f1 s1 p5>(Input<t3>))))|TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a7,a3);AttrsEq(a8,a4);FuncEq(f1,f0);SchemaEq(s1,s0);PredicateEq(p5,p1);PredicateDomainSplit(p0,p2,p3,p4,a9,a10,a11,a12,t0,t1);CorrelationEquality(p4,a11,a12);AttrsSub(a5,a3);AggFilterCommute(a3,a4,f0,s0,p1,p2,a5);KeyedOutput(a13,t0);AttrsUnion(a14,a13,a11);SchemaFromAttrs(s2,a14);ErrorFree(p0);Deterministic(p0);ErrorFree(p1);ErrorFree(p2);Deterministic(p2);ErrorFree(p3);Deterministic(p3);ErrorFree(p4);Deterministic(p4);ErrorFree(p5);ErrorFree(a4);ErrorFree(f0);ErrorFree(a8);ErrorFree(f1);ErrorFree(a14)

# Replaces CXformLeftAntiSemiApply2LeftAntiSemiJoinNoCorrelations. AntiApply
# binds the exact inner-to-outer dependency set; AttrsEmpty is therefore the
# native promise expressed as data. AntiJoin is ordinary NOT EXISTS semantics,
# distinct from the NULL-aware AntiJoinNotIn family. This exact RuleIR is
# accepted by the FormalSQL/Rocq kernel.
AntiApply<p0 a0 a1 a2>(Input<t0>,Input<t1>)|AntiJoin<p1 a3 a4>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsEmpty(a2);AttrsSub(a0,t0);AttrsSub(a1,t1);ErrorFree(p0);ErrorFree(p1)

# Replaces CXformLeftAntiSemiApplyNotIn2LeftAntiSemiJoinNotInNoCorrelations.
# AntiApplyNotIn and AntiJoinNotIn are first-class NULL-aware operators rather
# than aliases of ordinary anti semantics. Their predicate denotes the
# user-visible ALL comparison; the ORCA adapter alone handles the inverse
# comparison stored by its physical operator representation. AttrsEmpty is the
# native xform's complete uncorrelated applicability domain. This exact RuleIR
# was proved EQ by SQLSolver on 2026-08-31.
AntiApplyNotIn<p0 a0 a1 a2>(Input<t0>,Input<t1>)|AntiJoinNotIn<p1 a3 a4>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsEmpty(a2);AttrsSub(a0,t0);AttrsSub(a1,t1)

# Replaces the single correlated-Filter decorrelation domain of
# CXformLeftAntiSemiApplyNotIn2LeftAntiSemiJoinNotIn. The first target predicate
# is the user-visible ALL comparison; the second is the RHS qualification that
# selects which inner rows participate. The adapter emits ORCA's equivalent raw
# predicate, inverse(comparison) AND qualification, without conflating the two
# dependency domains. This exact RuleIR was proved EQ by SQLSolver on
# 2026-08-31.
AntiApplyNotIn<p0 a0 a1 a2>(Input<t0>,Filter<p1 a3 a4>(Input<t1>))|AntiJoinNotIn<p2 a5 a6 p3 a7 a8>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p2,p0);AttrsEq(a5,a0);AttrsEq(a6,a1);PredicateEq(p3,p1);AttrsEq(a7,a4);AttrsEq(a8,a3);AttrsEq(a2,a4);AttrsSub(a0,t0);AttrsSub(a1,t1);AttrsSub(a3,t1);AttrsSub(a4,t0)

# Extends the NULL-aware decorrelation domain across a grouped aggregate when
# its correlation key is not already grouped. AttrsUnion/SchemaUnion construct
# the compensated aggregate, CorrelationEquality validates an exact conjunction
# of cross-input equality edges, and AggCorrelationGrouping states the reusable
# operator-local movement contract. QuantifiedPredicateEq preserves the actual
# three-valued ALL operator and arguments independently of the RHS qualifier.
# This exact RuleIR was accepted by the FormalSQL/Rocq kernel on 2026-08-31.
AntiApplyNotIn<p0 a0 a1 a2>(Input<t0>,Agg<a3 a4 f0 s0 p1>(Filter<p2 a5 a6>(Input<t1>)))|AntiJoinNotIn<p3 a7 a8 p4 a9 a10>(Input<t2>,Agg<a11 a12 f1 s1 p5>(Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p3,p0);QuantifiedPredicateEq(p3,p0);AttrsEq(a7,a0);AttrsEq(a8,a1);PredicateEq(p4,p2);AttrsEq(a9,a6);AttrsEq(a10,a5);AttrsEq(a2,a6);AttrsUnion(a11,a3,a5);AttrsEq(a12,a4);FuncEq(f1,f0);SchemaUnion(s1,s0,a5);PredicateEq(p5,p1);CorrelationEquality(p2,a5,a6);AggCorrelationGrouping(p2,a3,a11,a4,f0,s0,s1,p1,a5,a6);AttrsSub(a0,t0);AttrsSub(a1,s0);AttrsSub(a3,t1);AttrsSub(a4,t1);AttrsSub(a5,t1);AttrsSub(a6,t0);Deterministic(p0);Deterministic(p3);Deterministic(p2);Deterministic(p4);ErrorFree(p0);ErrorFree(a4);ErrorFree(f0);ErrorFree(p1);ErrorFree(p2);ErrorFree(p3);ErrorFree(a12);ErrorFree(f1);ErrorFree(p5);ErrorFree(p4)

# Extends NULL-aware decorrelation across a cumulative Window.  The runtime
# contract admits only a pure equality correlation whose local keys are covered
# by PARTITION BY; order/items cannot reference outer columns and the window
# item must be an error-free, total aggregate supported by the shared checker.
# The target keeps the exact Window metadata and moves the correlation into the
# AntiJoinNotIn qualifier.  FormalSQL/Rocq accepted this operator-local theorem
# on 2026-08-31.
AntiApplyNotIn<p0 a0 a1 a2>(Input<t0>,WindowRows<a3 o0 w0>(Filter<p1 a4 a5>(Input<t1>)))|AntiJoinNotIn<p2 a6 a7 p3 a8 a9>(Input<t2>,WindowRows<a10 o1 w1>(Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p2,p0);QuantifiedPredicateEq(p2,p0);AttrsEq(a6,a0);AttrsEq(a7,a1);PredicateEq(p3,p1);AttrsEq(a8,a5);AttrsEq(a9,a4);AttrsEq(a2,a5);AttrsEq(a10,a3);OrderEq(o1,o0);WindowEq(w1,w0);WindowCorrelationPartition(p1,a3,o0,w0,a4,a5);CorrelationEquality(p1,a4,a5);AttrsSub(a0,t0);AttrsSub(a4,t1);AttrsSub(a5,t0);Deterministic(p0);Deterministic(p2);Deterministic(p1);Deterministic(p3);ErrorFree(p0);ErrorFree(w0);ErrorFree(p1);ErrorFree(p2);ErrorFree(w1);ErrorFree(p3)

# The explicit-frame sibling covers ORCA's normalized representation of SQL
# default frames as well as genuine ROWS/RANGE frames.  FrameEq preserves the
# exact frame and the frame-aware contract additionally rejects outer-column
# references in frame edges.  FormalSQL/Rocq accepted the generic frame theorem
# on 2026-08-31.
AntiApplyNotIn<p0 a0 a1 a2>(Input<t0>,Window<a3 o0 m0 w0>(Filter<p1 a4 a5>(Input<t1>)))|AntiJoinNotIn<p2 a6 a7 p3 a8 a9>(Input<t2>,Window<a10 o1 m1 w1>(Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p2,p0);QuantifiedPredicateEq(p2,p0);AttrsEq(a6,a0);AttrsEq(a7,a1);PredicateEq(p3,p1);AttrsEq(a8,a5);AttrsEq(a9,a4);AttrsEq(a2,a5);AttrsEq(a10,a3);OrderEq(o1,o0);FrameEq(m1,m0);WindowEq(w1,w0);WindowFrameCorrelationPartition(p1,a3,o0,m0,w0,a4,a5);CorrelationEquality(p1,a4,a5);AttrsSub(a0,t0);AttrsSub(a4,t1);AttrsSub(a5,t0);Deterministic(p0);Deterministic(p2);Deterministic(p1);Deterministic(p3);ErrorFree(p0);ErrorFree(w0);ErrorFree(p1);ErrorFree(p2);ErrorFree(w1);ErrorFree(p3)

# Pull a correlated Filter above a Window when every local correlation key is
# covered by the partition. These are operator-local rules: once the Filter is
# exposed, every Apply family reuses its existing Filter decorrelation rule by
# ordinary Cascade chaining. Both RuleIRs are accepted by FormalSQL/Rocq; no
# Apply-specific lowering is hidden in this normalization.
WindowRows<a0 o0 w0>(Filter<p0 a1 a2>(Input<t0>))|Filter<p1 a4 a5>(WindowRows<a3 o1 w1>(Input<t1>))|TableEq(t1,t0);AttrsEq(a3,a0);OrderEq(o1,o0);WindowEq(w1,w0);PredicateEq(p1,p0);AttrsEq(a4,a1);AttrsEq(a5,a2);WindowCorrelationPartition(p0,a0,o0,w0,a1,a2);Deterministic(p0);ErrorFree(p0);ErrorFree(p1);ErrorFree(w0);ErrorFree(w1)
Window<a0 o0 m0 w0>(Filter<p0 a1 a2>(Input<t0>))|Filter<p1 a4 a5>(Window<a3 o1 m1 w1>(Input<t1>))|TableEq(t1,t0);AttrsEq(a3,a0);OrderEq(o1,o0);FrameEq(m1,m0);WindowEq(w1,w0);PredicateEq(p1,p0);AttrsEq(a4,a1);AttrsEq(a5,a2);WindowFrameCorrelationPartition(p0,a0,o0,m0,w0,a1,a2);Deterministic(p0);ErrorFree(p0);ErrorFree(p1);ErrorFree(w0);ErrorFree(w1)

# Replaces the single correlated-Filter decorrelation domain of
# CXformLeftSemiApply2LeftSemiJoin. AttrsUnion derives the target predicate's
# complete per-child dependencies when the Apply predicate and pulled Filter
# predicate reference different columns. This exact RuleIR is accepted by the
# generic FormalSQL/Rocq proof kernel.
SemiApply<p0 a0 a1 a2>(Input<t0>,Filter<p1 a3 a4>(Input<t1>))|SemiJoin<p2 a5 a6>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateAnd(p2,p0,p1);AttrsEq(a2,a4);AttrsUnion(a5,a0,a4);AttrsUnion(a6,a1,a3);AttrsSub(a0,t0);AttrsSub(a1,t1);AttrsSub(a3,t1);AttrsSub(a4,t0);Deterministic(p0);Deterministic(p1);Deterministic(p2);ErrorFree(p0);ErrorFree(p1);ErrorFree(p2)

# Collapses any two adjacent correlated or ordinary Filters into one explicit
# conjunction. This is an independently Rocq-proved normalization rule, not an
# Apply-specific adapter; it lets existing one-Filter rules consume deeper
# predicate stacks through ordinary Cascade chaining.
Filter<p0 a0 a1>(Filter<p1 a2 a3>(Input<t0>))|Filter<p2 a4 a5>(Input<t1>)|TableEq(t1,t0);PredicateAnd(p2,p0,p1);AttrsUnion(a4,a0,a2);AttrsUnion(a5,a1,a3);AttrsSub(a0,t0);AttrsSub(a2,t0);Deterministic(p0);Deterministic(p1);Deterministic(p2);ErrorFree(p0);ErrorFree(p1);ErrorFree(p2)

# Replaces the single correlated-Filter decorrelation domain of
# CXformLeftAntiSemiApply2LeftAntiSemiJoin. This is ordinary NOT EXISTS
# semantics; AntiJoinNotIn remains a separate NULL-aware operator family.
# PredicateAnd and AttrsUnion preserve the same dependency partition as the
# positive SemiApply rule. This exact RuleIR is accepted by FormalSQL/Rocq.
AntiApply<p0 a0 a1 a2>(Input<t0>,Filter<p1 a3 a4>(Input<t1>))|AntiJoin<p2 a5 a6>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateAnd(p2,p0,p1);AttrsEq(a2,a4);AttrsUnion(a5,a0,a4);AttrsUnion(a6,a1,a3);AttrsSub(a0,t0);AttrsSub(a1,t1);AttrsSub(a3,t1);AttrsSub(a4,t0);Deterministic(p0);Deterministic(p1);Deterministic(p2);ErrorFree(p0);ErrorFree(p1);ErrorFree(p2)

# Moves a correlated Filter above a safe Compute/LET layer, exposing the
# Filter-rooted inner alternative consumed by the SemiApply decorrelation rule
# above. ExprFilterCommute is proved as a generic expression-algebra obligation.
Compute<e0 a0 s0>(Filter<p0 a1 a2>(Input<t0>))|Filter<p1 a3 a4>(Compute<e1 a5 s1>(Input<t1>))|TableEq(t1,t0);ExprListEq(e1,e0);AttrsEq(a5,a0);SchemaEq(s1,s0);PredicateEq(p1,p0);AttrsEq(a3,a1);AttrsEq(a4,a2);ExprFilterCommute(e0,p0,s0);ErrorFree(e0);Deterministic(e0)

# Pull a correlated predicate through a grouped aggregate when every local
# dependency is an existing grouping key. General decorrelation that must add
# new grouping columns is intentionally a separate schema-construction domain.
Agg<a0 a1 f0 s0 p0>(Filter<p1 a2 a3>(Input<t0>))|Filter<p2 a6 a7>(Agg<a4 a5 f1 s1 p3>(Input<t1>))|TableEq(t1,t0);AttrsEq(a4,a0);AttrsEq(a5,a1);FuncEq(f1,f0);SchemaEq(s1,s0);PredicateEq(p3,p0);PredicateEq(p2,p1);AttrsEq(a6,a2);AttrsEq(a7,a3);AttrsSub(a2,a0);AggFilterCommute(a0,a1,f0,s0,p0,p1,a2);Deterministic(p1);ErrorFree(a1);ErrorFree(f0);ErrorFree(p0);ErrorFree(p1);ErrorFree(a5);ErrorFree(f1);ErrorFree(p3);ErrorFree(p2)

# Atomically decorrelates a SemiApply across a grouped aggregate. Equality
# correlation columns are retained or added to grouping as needed. The atomic
# Apply-rooted replacement preserves
# the Cascade memo output contract; ordered unions construct the expanded
# grouping, predicate dependencies, and aggregate schema. This exact RuleIR is
# accepted by the generic FormalSQL/Rocq proof kernel.
SemiApply<p0 a0 a1 a2>(Input<t0>,Agg<a3 a4 f0 s0 p1>(Filter<p2 a5 a6>(Input<t1>)))|SemiJoin<p3 a7 a8>(Input<t2>,Agg<a9 a10 f1 s1 p4>(Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);PredicateAnd(p3,p0,p2);AttrsEq(a2,a6);AttrsUnion(a7,a0,a6);AttrsUnion(a8,a1,a5);AttrsUnion(a9,a3,a5);AttrsEq(a10,a4);FuncEq(f1,f0);SchemaUnion(s1,s0,a5);PredicateEq(p4,p1);AggCorrelationPullup(p0,p2,p3,a3,a9,a4,f0,s0,s1,p1,a5,a6);AttrsSub(a0,t0);AttrsSub(a1,s0);AttrsSub(a3,t1);AttrsSub(a4,t1);AttrsSub(a5,t1);AttrsSub(a6,t0);Deterministic(p0);Deterministic(p2);Deterministic(p3);ErrorFree(p0);ErrorFree(a4);ErrorFree(f0);ErrorFree(p1);ErrorFree(p2);ErrorFree(p3);ErrorFree(a10);ErrorFree(f1);ErrorFree(p4)

# Negative-polarity counterpart of the atomic grouped decorrelation rule.
# AggCorrelationPullup has one polarity-independent equality/grouping contract;
# FormalSQL/Rocq proves both EXISTS and NOT EXISTS conclusions from it.
AntiApply<p0 a0 a1 a2>(Input<t0>,Agg<a3 a4 f0 s0 p1>(Filter<p2 a5 a6>(Input<t1>)))|AntiJoin<p3 a7 a8>(Input<t2>,Agg<a9 a10 f1 s1 p4>(Input<t3>))|TableEq(t2,t0);TableEq(t3,t1);PredicateAnd(p3,p0,p2);AttrsEq(a2,a6);AttrsUnion(a7,a0,a6);AttrsUnion(a8,a1,a5);AttrsUnion(a9,a3,a5);AttrsEq(a10,a4);FuncEq(f1,f0);SchemaUnion(s1,s0,a5);PredicateEq(p4,p1);AggCorrelationPullup(p0,p2,p3,a3,a9,a4,f0,s0,s1,p1,a5,a6);AttrsSub(a0,t0);AttrsSub(a1,s0);AttrsSub(a3,t1);AttrsSub(a4,t1);AttrsSub(a5,t1);AttrsSub(a6,t0);Deterministic(p0);Deterministic(p2);Deterministic(p3);ErrorFree(p0);ErrorFree(a4);ErrorFree(f0);ErrorFree(p1);ErrorFree(p2);ErrorFree(p3);ErrorFree(a10);ErrorFree(f1);ErrorFree(p4)

# Replaces the complete pure-grouping domain of CXformPushGbBelowUnionAll.
# The outer grouping may be any subset of the UnionAll row. Explicit output
# bindings preserve the reduced target schema and set-op position maps. This
# exact RuleIR returned EQ from WeTune SQLSolver on 2026-08-29.
Proj*<a0 s0>(Union<a1 s1>(Input<t0>,Input<t1>))|Union*<a2 s2>(Proj*<a3 s3>(Input<t2>),Proj*<a4 s4>(Input<t3>))|AttrsSub(a0,a1);AttrsSub(a0,s1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a2,a0);SchemaEq(s2,s0);AttrsEq(a3,a0);SchemaEq(s3,s0);AttrsEq(a4,a0);SchemaEq(s4,s0)

# Replaces the pure-grouping domain of CXformPushGbBelowUnion. The outer
# grouping may be any subset of the Union distinct row; explicit output
# bindings preserve the reduced target schema and set-op position maps. This
# exact RuleIR returned EQ from WeTune SQLSolver on 2026-08-29.
Proj*<a0 s0>(Union*<a1 s1>(Input<t0>,Input<t1>))|Union*<a2 s2>(Proj*<a3 s3>(Input<t2>),Proj*<a4 s4>(Input<t3>))|AttrsSub(a0,a1);AttrsSub(a0,s1);TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a2,a0);SchemaEq(s2,s0);AttrsEq(a3,a0);SchemaEq(s3,s0);AttrsEq(a4,a0);SchemaEq(s4,s0)

# Rules in this file exist only to replace native ORCA logical xforms. Each
# rule must be independently proved before admission and carry causal E2E.
# DIRECT(metadata-property): the relational skeleton is intentionally stable;
# MinimalGrouping changes optimizer metadata consumed by later xforms.
# Replaces the functional-dependency metadata branch of
# CXformSimplifyGbAgg for real aggregates. MinimalGrouping is an explicit
# optimizer-property premise: it preserves the full semantic grouping while
# deriving the smaller child-dependent grouping used by later xforms. The
# exact RuleIR is an outcome-equivalence proof accepted by FormalSQL/Rocq;
# aligned expressions preserve errors, so no scalar ErrorFree premise is
# required.
Agg<a0 a1 f0 s0 p0>(Input<t0>)|Agg<a2 a3 f1 s1 p1>(Input<t1>)|AttrsSub(a0,t0);AttrsSub(a1,t0);TableEq(t1,t0);AttrsEq(a2,a0);AttrsEq(a3,a1);FuncEq(f1,f0);SchemaEq(s1,s0);PredicateEq(p1,p0);MinimalGrouping(a0,s0)

# Replaces CXformInnerApply2InnerJoinNoCorrelations. InnerApply exposes the
# exact right-to-left dependency set separately from the scalar predicate's
# ordinary child dependencies. AttrsEmpty states the native xform's complete
# applicability condition. The exact RuleIR is an outcome-equivalence proof
# accepted by the FormalSQL/Rocq kernel; preserving the same predicate also
# preserves scalar errors without an ErrorFree assumption.
InnerApply<p0 a0 a1 a2>(Input<t0>,Input<t1>)|InnerJoin<p1 a3 a4>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsEmpty(a2)

# Replaces CXformLeftOuterApply2LeftOuterJoinNoCorrelations. LeftApply shares
# the JoinApply correlation contract with InnerApply but retains NULL-extension
# through an explicit LeftJoin target. AttrsEmpty excludes dependencies on the
# current left row while permitting references supplied by an enclosing scope,
# matching the native promise. This exact RuleIR is an outcome-equivalence
# proof accepted by FormalSQL/Rocq.
LeftApply<p0 a0 a1 a2>(Input<t0>,Input<t1>)|LeftJoin<p1 a3 a4>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateEq(p1,p0);AttrsEq(a3,a0);AttrsEq(a4,a1);AttrsEmpty(a2)

# Replaces the correlated-Filter branch of CXformInnerApply2InnerJoin.  The
# Apply predicate and the right Filter predicate become one Join predicate;
# AttrsUnion preserves the exact dependency order on each input.  Correlation
# metadata must name the Filter's outer dependencies, and total deterministic
# predicates make the SQLSolver bag proof a sound replacement obligation.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-31.
InnerApply<p0 a0 a1 a2>(Input<t0>,Filter<p1 a3 a4>(Input<t1>))|InnerJoin<p2 a5 a6>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateAnd(p2,p0,p1);AttrsUnion(a5,a0,a4);AttrsUnion(a6,a1,a3);AttrsEq(a2,a4);AttrsSub(a0,t0);AttrsSub(a1,t1);AttrsSub(a3,t1);AttrsSub(a4,t0);Deterministic(p0);Deterministic(p1);Deterministic(p2);ErrorFree(p0);ErrorFree(p1);ErrorFree(p2)

# LeftOuter sibling of the rule above.  The same predicate/dependency fusion
# applies, while LeftJoin retains the unmatched outer row with NULL-extension.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-31.
LeftApply<p0 a0 a1 a2>(Input<t0>,Filter<p1 a3 a4>(Input<t1>))|LeftJoin<p2 a5 a6>(Input<t2>,Input<t3>)|TableEq(t2,t0);TableEq(t3,t1);PredicateAnd(p2,p0,p1);AttrsUnion(a5,a0,a4);AttrsUnion(a6,a1,a3);AttrsEq(a2,a4);AttrsSub(a0,t0);AttrsSub(a1,t1);AttrsSub(a3,t1);AttrsSub(a4,t0);Deterministic(p0);Deterministic(p1);Deterministic(p2);ErrorFree(p0);ErrorFree(p1);ErrorFree(p2)

# Line 1 replaces the grouping-subset branch of CXformCollapseGbAgg, including
# equal grouping sets. Proj* admits only pure, unsplit global dedup aggregates.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-28.
# Lines 11 and 13 cover the complete output space of CXformCollapseProject:
# the first moves every independent upper Compute definition into the lower
# layer; the second moves the maximal safe subset and retains a real residual.
# Both exact RuleIR strings are outcome-equivalence proof inputs accepted by
# the FormalSQL/Rocq 9.2 kernel on 2026-08-28. ExprConcat/ExprSplit remain
# explicit semantic premises checked generically against the live project
# lists; neither rule is identified by C++ code.
# Lines 15, 17, 19, 21, and 23 remove a pure DISTINCT from the inner relation
# of positive IN, EXISTS, NOT EXISTS, ANY, and ALL respectively. The ordinary
# target Proj preserves the complete
# SELECT-list/schema proof binding; pgORCA lowers that pass-through view to the
# native bare relational child. All three exact rules returned EQ from WeTune's
# SQLSolver backend; NOT EXISTS was verified on 2026-08-29 through its generic
# RuleIR/U-expression operator rather than a rule-specific proof path.
# ANY/ALL bind the complete comparison predicate; their exact rules were also
# proved EQ by the generic SQLSolver U-expression backend on 2026-08-29.
# Line 25 removes a redundant pure Dedup above an InnerJoin when the projected
# outer attributes and the inner equality key are both unique. The explicit
# Join predicate binding preserves every non-equality residual and records its
# dependencies by child. This directly covers the corresponding unique-output
# domain of CXformPushGbDedupBelowJoin without reproducing its staging shape.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-29.
# Lines 41 and 43 jointly replace CXformSimplifyLeftOuterJoin. The first covers
# its literal constant-FALSE source; the second covers the real preprocess
# routing shape LeftJoin(left, Filter(right,FALSE), TRUE). Empty<t> preserves
# the bound right schema while removing its cardinality and cost. Both exact
# RuleIR strings returned EQ from SQLSolver on 2026-08-29.
# Line 37 covers mixed grouping vectors that contain columns from both join
# children. AttrsIntersect derives the ordered outer-owned portion for the
# pushed Dedup and its schema without requiring the source grouping to belong
# to a single relation. Both tuple components and the FK containment premise
# are modeled by the generic SQLSolver U-expression backend.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-29.
# Line 39 is the residual-predicate sibling of line 37. The residual outer
# dependencies must be subsets of both the source grouping and outer domain;
# inner dependencies remain available from the unmodified referred child.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-29.
# Line 31 pushes a pure outer-key Dedup below an InnerJoin whose equality is a
# declared foreign-key reference to a unique inner key. The ordinary target
# Proj restores the source output after the staged Dedup; both projection
# layers bind the complete grouping attrs and schema. This covers the exact-FK
# grouping branch shared by CXformPushGbBelowJoin and
# CXformPushGbDedupBelowJoin rather than the earlier unique-output shortcut.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-29.
# Line 33 extends the same staged rewrite to arbitrary outer grouping attrs
# containing the FK, including nullable references. The inner-join equality
# supplies the local non-null witness; SQLSolver propagates it through the
# projected grouping tuple without requiring a global NotNull constraint.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-29.
# Line 35 covers the residual-predicate sibling explicitly. Its outer predicate
# dependencies must be contained in the grouping attrs, while inner dependencies
# remain available from the unmodified referred side. PredicateEq and both
# dependency vectors make the proved RuleIR identical to the runtime rewrite.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-29.
# Lines 27 and 29 cover the two non-simple-predicate branches of
# CXformLeftSemiJoin2InnerJoinUnderGb. The five-symbol InSubFilter preserves the
# equality keys plus residual; the three-symbol Exists preserves a complete
# predicate when no equality key can be extracted. Both record dependencies on
# each input. The source Proj* is exposed only when the semi join's output has a
# key, matching the native xform's precondition. The target Proj* remains
# explicit because the InnerJoin can multiply an outer row when multiple inner
# rows satisfy the predicate.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-29.
# Line 9 covers the equality branch of
# CXformLeftSemiJoin2InnerJoin. InSubFilter is the shared view over both the
# pre-unnest form and CLogicalLeftSemiJoin; the target deduplicates the inner
# key before joining, preserving semi-join bag multiplicity.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-28.
# Line 5 is the proved InnerJoin branch of CXformPushJoinBelowLeftUnionAll.
# Complete source Join output binding lets the new target Union preserve the
# parent row, while shared positional mapping remaps predicates and freshens
# repeated target inputs. WeTune ProveDslRule: EQ, SQLSOLVER, 2026-08-28.
# Line 7 is the independently proved LeftJoin branch of the same xform.
# It distributes only across the preserved (left) input; right-side LeftJoin
# distribution is intentionally excluded because it is not bag-equivalent.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-28.
# Line 3 replaces CXformUnion2UnionAll. The explicit Union output binding makes
# Proj* a full-row identity dedup rather than an arbitrary subset projection.
# WeTune ProveDslRule: EQ, SQLSOLVER, verified 2026-08-28.

# BRIDGE(view-materialization): the C++ aggregate view constructs this regular
# alternative; the identity rule materializes the visible compensation chain.
# The non-correlated GbAgg2Apply alternative inserts a compensation Project
# above LeftApply. Preserve every Project and Apply binding exactly; this
# structural identity was accepted by the FormalSQL/Rocq kernel on 2026-08-30.
Agg<a0 a1 f0 s0 p0>(Proj<a2 s1>(LeftApply<p1 a3 a4 a5>(Input<t0>,Input<t1>)))|Agg<a6 a7 f1 s2 p2>(Proj<a8 s3>(LeftApply<p3 a9 a10 a11>(Input<t2>,Input<t3>)))|TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a6,a0);AttrsEq(a7,a1);FuncEq(f1,f0);SchemaEq(s2,s0);PredicateEq(p2,p0);AttrsEq(a8,a2);SchemaEq(s3,s1);PredicateEq(p3,p1);AttrsEq(a9,a3);AttrsEq(a10,a4);AttrsEq(a11,a5)

# BRIDGE(view-materialization): the C++ aggregate view constructs this regular
# alternative; the identity rule materializes the visible compensation chain.
# A production alternative may add a real aggregate compensation layer above
# LeftApply. This exact structural identity was accepted by FormalSQL/Rocq on
# 2026-08-31; the rule itself is independent of subquery kind.
Agg<a0 a1 f0 s0 p0>(Agg<a2 a3 f1 s1 p1>(LeftApply<p2 a4 a5 a6>(Input<t0>,Input<t1>)))|Agg<a7 a8 f2 s2 p3>(Agg<a9 a10 f3 s3 p4>(LeftApply<p5 a11 a12 a13>(Input<t2>,Input<t3>)))|TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a7,a0);AttrsEq(a8,a1);FuncEq(f2,f0);SchemaEq(s2,s0);PredicateEq(p3,p0);AttrsEq(a9,a2);AttrsEq(a10,a3);FuncEq(f3,f1);SchemaEq(s3,s1);PredicateEq(p4,p1);PredicateEq(p5,p2);AttrsEq(a11,a4);AttrsEq(a12,a5);AttrsEq(a13,a6)

# BRIDGE(view-materialization): the C++ aggregate view constructs this quantified
# alternative; the identity rule materializes the visible compensation chain.
# Quantified value decorrelation adds the same grouping compensation plus a
# Project carrying its count/null summary. FormalSQL/Rocq accepted the complete
# operator-local identity on 2026-08-31.
Agg<a0 a1 f0 s0 p0>(Agg<a2 a3 f1 s1 p1>(Proj<a4 s2>(LeftApply<p2 a5 a6 a7>(Input<t0>,Input<t1>))))|Agg<a8 a9 f2 s3 p3>(Agg<a10 a11 f3 s4 p4>(Proj<a12 s5>(LeftApply<p5 a13 a14 a15>(Input<t2>,Input<t3>))))|TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a8,a0);AttrsEq(a9,a1);FuncEq(f2,f0);SchemaEq(s3,s0);PredicateEq(p3,p0);AttrsEq(a10,a2);AttrsEq(a11,a3);FuncEq(f3,f1);SchemaEq(s4,s1);PredicateEq(p4,p1);AttrsEq(a12,a4);SchemaEq(s5,s2);PredicateEq(p5,p2);AttrsEq(a13,a5);AttrsEq(a14,a6);AttrsEq(a15,a7)

# BRIDGE(view-materialization): the C++ aggregate view constructs this grouping
# alternative; the identity rule materializes the visible compensation chain.
# A grouping-only compensation GbAgg is the DSL's Proj* (dedup), not a real
# Agg. Preserve that distinct domain around LeftApply. FormalSQL/Rocq accepted
# this operator-local identity on 2026-08-31.
Agg<a0 a1 f0 s0 p0>(Proj*<a2 s1>(LeftApply<p1 a3 a4 a5>(Input<t0>,Input<t1>)))|Agg<a6 a7 f1 s2 p2>(Proj*<a8 s3>(LeftApply<p3 a9 a10 a11>(Input<t2>,Input<t3>)))|TableEq(t2,t0);TableEq(t3,t1);AttrsEq(a6,a0);AttrsEq(a7,a1);FuncEq(f1,f0);SchemaEq(s2,s0);PredicateEq(p2,p0);AttrsEq(a8,a2);SchemaEq(s3,s1);PredicateEq(p3,p1);AttrsEq(a9,a3);AttrsEq(a10,a4);AttrsEq(a11,a5)

# Replace CXformMaxOneRow2Assert with the same indivisible cardinality-contract
# implementation used by ORCA: a row-number SequenceProject followed by an
# Assert carrying ExmiSQLMaxOneRow.  The DSL target is intentionally a macro,
# not a general Assert matcher, so arbitrary assertion predicates are never
# conflated with scalar-subquery outcome semantics.
# WeTune ProveDslRule: OUTCOME_EQ, FORMALSQL, verified 2026-08-31.
MaxOneRow(Input<t0>)|AssertMaxOneRow(Input<t1>)|TableEq(t1,t0)
