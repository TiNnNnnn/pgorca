{
  "description": "Direct MaxOneRow cardinality check with logical Assert lowering and scalar SubPlan alternatives disabled",
  "plans": [
    {
      "name": "physical_only",
      "dsl": false,
      "trace": true,
      "disable_xforms": [
        "CXformMaxOneRow2Assert",
        "CXformImplementLeftOuterCorrelatedApply",
        "CXformImplementInnerCorrelatedApply"
      ],
      "assert_maxonerow": true,
      "contains": [
        "Optimizer: pg_orca",
        "Custom Scan (Assert)",
        "MaxOneRow"
      ],
      "not_contains": [
        "WindowAgg"
      ],
      "alternative": [
        "CXformImplementMaxOneRow"
      ]
    }
  ],
  "rows": {
    "disable_xforms": [
      "CXformMaxOneRow2Assert",
      "CXformImplementLeftOuterCorrelatedApply",
      "CXformImplementInnerCorrelatedApply"
    ],
    "policy": "disable_all.policy",
    "assert_maxonerow": true,
    "error_sqlstate": "21000",
