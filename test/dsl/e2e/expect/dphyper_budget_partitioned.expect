{
  "description": "Budget statistics scoping preserves a partitioned child and duplicate/NULL bag semantics",
  "plans": [
    {
      "name": "unbounded",
      "dsl": true,
      "dphyper": true,
      "dphyper_shadow": false,
      "dphyper_top_down": true,
      "dphyper_verify": true,
      "enable_cost_budget": false,
      "contains": [
        "Optimizer: pg_orca",
        "DPHyperVerify: status=equal"
      ],
      "not_contains": [
        "DPHyperVerify: status=mismatch",
        "Failed assertion"
      ],
      "joins": 1
    },
    {
      "name": "bounded",
      "dsl": true,
      "dphyper": true,
      "dphyper_shadow": false,
      "dphyper_top_down": true,
      "dphyper_verify": true,
