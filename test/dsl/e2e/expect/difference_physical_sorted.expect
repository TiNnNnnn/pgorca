{
  "description": "Direct SetOp with optional logical lowerings and DSL disabled",
  "plans": [
    {
      "name": "physical_only",
      "dsl": false,
      "trace": true,
      "disable_xforms": [
        "CXformIntersect2Join",
        "CXformIntersectAll2LeftSemiJoin",
        "CXformDifference2LeftAntiSemiJoin",
        "CXformDifferenceAll2LeftAntiSemiJoin"
      ],
      "contains": [
        "Optimizer: pg_orca",
        "SetOp"
      ],
      "not_contains": [
        "HashSetOp"
      ],
      "alternative": [
        "CXformImplementSetOp"
      ]
    }
  ],
  "rows": {
    "disable_xforms": [
      "CXformIntersect2Join",
      "CXformIntersectAll2LeftSemiJoin",
      "CXformDifference2LeftAntiSemiJoin",
      "CXformDifferenceAll2LeftAntiSemiJoin"
    ],
    "policy": "disable_all.policy",
    "output": [
      "1,2"
    ],
    "postgres_output": [
      "1,2"
    ]
  }
}
