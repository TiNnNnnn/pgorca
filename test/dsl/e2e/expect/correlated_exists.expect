        "\"rule_id\":8,\"status\":\"applied\"",
        "IS NULL"
      ],
      "alternative": [
        "CXformDSLRule_Exists"
      ],
      "joins": 0
    }
  ],
  "rows": {
    "output": [
      "10",
      "30"
    ],
    "postgres_output": [
      "10",
      "30"
    ]
  }
