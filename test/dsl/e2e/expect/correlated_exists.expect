{
  "description": "Correlated EXISTS adapter retains the implied null guard",
  "plans": [
    {
      "name": "off",
      "dsl": false,
      "contains": [
        "Optimizer: pg_orca"
      ]
    },
    {
      "name": "on",
      "trace": true,
      "contains": [
