      "trace": true,
      "contains": [
        "DPHyper: status=fallback reason=edge_budget",
        "edges=1 budget=1",
        "Xform: CXformExpandNAryJoinDPv2"
      ],
      "not_contains": [
        "DPHyper: status=applied"
      ],
      "joins": 2
    }
  ],
  "rows": {
