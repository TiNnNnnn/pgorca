{
  "description": "DPHyper joins disconnected predicate components at frozen Cartesian boundaries",
  "plans": [
    {
      "name": "replacement",
      "dsl": false,
      "dphyper": true,
      "dphyper_shadow": false,
      "trace": true,
      "contains": [
        "DPHyper: status=applied",
        "nodes=3",
        "cartesian_edges=1",
        "mode=replacement",
        "Xform: CXformImplementInnerJoin"
      ],
      "not_contains": [
        "Xform: CXformExpandNAryJoinDPv2",
        "Xform: CXformInnerJoinCommutativity",
        "Xform: CXformJoinAssociativity"
      ],
      "joins": 2
    },
    {
      "name": "cartesian-edge-budget-fallback",
      "dsl": false,
      "dphyper": true,
      "dphyper_edge_budget": 1,
