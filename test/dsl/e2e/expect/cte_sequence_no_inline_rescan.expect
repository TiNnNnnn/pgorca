{
  "description": "A shared CTE on the inner side of a nested loop remains rescannable without inlining",
  "plans": [
    {
      "name": "sequence_without_inlining",
      "dsl": false,
      "trace": true,
      "disable_xforms": [
        "CXformCTEAnchor2TrivialSelect",
        "CXformInlineCTEConsumer",
        "CXformInlineCTEConsumerUnderSelect"
      ],
      "contains": [
        "Optimizer: pg_orca",
        "Nested Loop",
        "CTE Scan"
      ],
      "alternative": [
        "CXformCTEAnchor2Sequence"
      ]
    }
  ],
  "rows": {
    "disable_xforms": [
      "CXformCTEAnchor2TrivialSelect",
      "CXformInlineCTEConsumer",
      "CXformInlineCTEConsumerUnderSelect"
    ],
    "policy": "disable_all.policy",
    "output": [
      "1,1",
      "1,1",
      "1,2",
      "1,3",
      "2,1",
      "2,1",
      "2,2",
      "2,3",
      "3,1",
      "3,1",
      "3,2",
      "3,3"
    ],
    "postgres_output": [
      "1,1",
      "1,1",
      "1,2",
      "1,3",
      "2,1",
      "2,1",
      "2,2",
      "2,3",
